POSTGRES_DB=mailai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password

# Production only (compose.prod.yaml): the restricted role the API connects as.
# It is created when the database volume is first initialised, so set these
# before the first start. Use a different password from POSTGRES_PASSWORD;
# `openssl rand -hex 32` gives one with no special characters.
# Development connects as POSTGRES_USER and ignores these.
DB_USER=mailai
DB_PASSWORD=replace-with-a-different-strong-password

SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long

# Domain for generated project addresses (e.g. abc123@mail.example.com).
# Its MX record must point at the server running the API.
INBOUND_EMAIL_DOMAIN=localhost
# Address the built-in SMTP server listens on. In production, forward public
# port 25 to this port.
SMTP_ADDR=:2525

# Production only (compose.prod.yaml): the domain the app is served on. Its DNS
# record must point at the server so a TLS certificate can be issued.
APP_DOMAIN=app.example.com
# Set to true when the site is served over HTTPS so auth cookies are HTTPS-only.
# compose.prod.yaml sets this itself; leave it false for local development.
COOKIE_SECURE=false

# API key for AI email summaries (https://platform.claude.com/settings/keys).
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
